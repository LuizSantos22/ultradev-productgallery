<?xml version="1.0"?>
<layout>
    <catalog_product_view>
        <reference name="head">
            <action method="addCss">
                <stylesheet>css/ultradev/productgallery.css</stylesheet>
            </action>
            <action method="removeItem">
                <type>skin_js</type>
                <name>js/infortis/jquery/plugins/jquery.cloudzoom.min.js</name>
            </action>
        </reference>
        <reference name="product.info.media">
            <action method="setTemplate">
                <template>ultradev/productgallery/media.phtml</template>
            </action>
        </reference>
    </catalog_product_view>
</layout>